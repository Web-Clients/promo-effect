# Production environment example (DO NOT COMMIT real secrets)

# Database (Supabase Postgres)
# NOTE: Supabase typically requires SSL.
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?schema=public&sslmode=require"

# JWT
JWT_SECRET="<GENERATE_A_LONG_RANDOM_SECRET>"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Server
NODE_ENV=production
PORT=3001
FRONTEND_URL="https://<YOUR_FRONTEND_DOMAIN>"

# Optional integrations (set if used)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@promo-efect.com"
SENDGRID_FROM_NAME="Promo-Efect"

# AISStream.io free WebSocket — sign up at https://aisstream.io
AISSTREAM_API_KEY=""

STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION=eu-central-1

# Telegram ops alerts — create a bot via @BotFather, add it to your ops group
# TELEGRAM_ADMIN_CHAT_ID = the group/chat id (use @RawDataBot or getUpdates to find it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Terminal49 — automatic ocean container milestones (carrier aggregator)
# Sign up at https://terminal49.com, get API token from Settings > API
TERMINAL49_API_KEY=
# Optional HMAC secret to verify inbound webhooks
TERMINAL49_WEBHOOK_SECRET=
