{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    // Guard: code after an unconditional return is dropped by the minifier while
    // hoisted functions keep referencing it -> "X is not defined" only in prod.
    "allowUnreachableCode": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "backend", "dist"]
}
